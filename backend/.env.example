# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed origins, or * for any.
CORS_ORIGIN=*

# --- Database ---
DATABASE_URL=postgresql://fadl:fadl@localhost:5433/fadl?schema=public

# --- Auth ---
# Use a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=15m

# --- Quran data ---
# Tafsirs that are not seeded locally (Ibn Kathir, Al-Sa'di...) are fetched on
# demand from the Quran.com public API and cached in the database.
QURAN_COM_API=https://api.quran.com/api/v4
AUDIO_CDN=https://cdn.islamic.network/quran

# --- Push notifications (Firebase Cloud Messaging) ---
# Path to a Firebase service-account JSON. When empty, the worker runs with the
# "log" driver and only prints the notifications it would send.
FIREBASE_SERVICE_ACCOUNT_PATH=
# How often the notification worker scans for due reminders (seconds).
NOTIFY_INTERVAL_SECONDS=60

# --- AI assistant (optional) ---
# When set, /assistant/ask grounds Claude on the retrieved verses/athkar.
# When empty, the endpoint returns retrieval results only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
