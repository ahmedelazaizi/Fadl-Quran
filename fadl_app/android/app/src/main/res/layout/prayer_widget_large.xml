<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    android:padding="16dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/prayer_widget_background">
    <TextView android:id="@+id/widget_prayer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/widget_primary" android:singleLine="true" />
    <TextView android:id="@+id/widget_time"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="18sp" android:textColor="@color/widget_primary" />
    <Chronometer android:id="@+id/widget_countdown"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="19sp" android:textColor="@color/widget_secondary" />
    <TextView android:id="@+id/widget_hijri"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/widget_secondary"
        android:singleLine="true" />
</LinearLayout>
